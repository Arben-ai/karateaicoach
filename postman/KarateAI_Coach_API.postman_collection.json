{
  "info": {
    "name": "KarateAI Coach API",
    "description": "Vollständige API-Dokumentation für die KarateAI Coach Anwendung. Base URL: https://karateaicoach.azurewebsites.net",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://karateaicoach.azurewebsites.net",
      "type": "string"
    },
    {
      "key": "token",
      "value": "Bearer <dein-auth0-token>",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Sportler",
      "item": [
        {
          "name": "Alle Sportler abrufen",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/sportler?page=0&size=10&search=&guertelgrad=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sportler"],
              "query": [
                { "key": "page", "value": "0", "description": "Seitennummer (Standard: 0)" },
                { "key": "size", "value": "10", "description": "Einträge pro Seite (Standard: 10)" },
                { "key": "search", "value": "", "description": "Suche nach Name (optional)" },
                { "key": "guertelgrad", "value": "", "description": "Filter nach Gürtelgrad (optional)" }
              ]
            },
            "description": "Gibt eine paginierte Liste aller Sportler zurück. Filterbar nach Name und Gürtelgrad. Erfordert Auth0-Token."
          }
        },
        {
          "name": "Sportler nach ID abrufen",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/sportler/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sportler", ":id"],
              "variable": [{ "key": "id", "value": "sp-123", "description": "MongoDB ID des Sportlers" }]
            },
            "description": "Gibt einen einzelnen Sportler anhand seiner ID zurück. 404 wenn nicht gefunden."
          }
        },
        {
          "name": "Eigenes Sportler-Profil abrufen",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/sportler/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sportler", "me"]
            },
            "description": "Gibt das Sportler-Profil des aktuell eingeloggten Benutzers zurück. Basiert auf der Auth0 User-ID aus dem JWT."
          }
        },
        {
          "name": "Sportler erstellen (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "{{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Max Muster\",\n  \"email\": \"max@example.com\",\n  \"guertelgrad\": \"Braun\",\n  \"gewicht\": 72.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sportler",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sportler"]
            },
            "description": "Erstellt einen neuen Sportler. 400 bei ungültiger E-Mail, 409 bei doppelter E-Mail oder Name."
          }
        },
        {
          "name": "Eigenes Sportler-Profil erstellen (automatisch beim Login)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "{{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Max Muster\",\n  \"email\": \"max@example.com\",\n  \"guertelgrad\": \"Grün\",\n  \"gewicht\": 68\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sportler/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sportler", "me"]
            },
            "description": "Erstellt oder verknüpft das Sportler-Profil des eingeloggten Benutzers. Wird automatisch beim ersten Login aufgerufen."
          }
        },
        {
          "name": "Eigenes Profil aktualisieren (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "{{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guertelgrad\": \"Schwarz\",\n  \"gewicht\": 74.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sportler/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sportler", "me"]
            },
            "description": "Aktualisiert Gürtelgrad und/oder Gewicht des eigenen Profils. Felder sind optional."
          }
        },
        {
          "name": "Sportler löschen (Admin oder Eigentümer)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/sportler/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sportler", ":id"],
              "variable": [{ "key": "id", "value": "sp-123", "description": "MongoDB ID des Sportlers" }]
            },
            "description": "Löscht einen Sportler. Nur Admin oder der Sportler selbst darf löschen. 403 bei fehlender Berechtigung, 404 wenn nicht gefunden."
          }
        }
      ]
    },
    {
      "name": "Trainingsfokus",
      "item": [
        {
          "name": "Alle Trainingsfokusse abrufen (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/trainingsfokus?page=0&size=10&status=&sportlerId=&sportlerName=&kategorie=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trainingsfokus"],
              "query": [
                { "key": "page", "value": "0", "description": "Seitennummer" },
                { "key": "size", "value": "10", "description": "Einträge pro Seite" },
                { "key": "status", "value": "", "description": "AKTIV oder INAKTIV (optional)" },
                { "key": "sportlerId", "value": "", "description": "Filter nach Sportler-ID (optional)" },
                { "key": "sportlerName", "value": "", "description": "Filter nach Sportlername (optional)" },
                { "key": "kategorie", "value": "", "description": "Filter nach Kategorie z.B. Kumite (optional)" }
              ]
            },
            "description": "Gibt alle Trainingsfokusse zurück. Nur Admin. Filterbar nach Status, Sportler-ID, Sportlername und Kategorie."
          }
        },
        {
          "name": "Eigene Trainingsfokusse abrufen",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/trainingsfokus/me?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trainingsfokus", "me"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            },
            "description": "Gibt die Trainingsfokusse des eingeloggten Sportlers zurück. Sortiert: ungelesene zuerst, dann nach Erstellungsdatum."
          }
        },
        {
          "name": "Trainingsfokus nach ID abrufen (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/trainingsfokus/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trainingsfokus", ":id"],
              "variable": [{ "key": "id", "value": "tf-123", "description": "MongoDB ID des Trainingsfokus" }]
            },
            "description": "Gibt einen einzelnen Trainingsfokus anhand der ID zurück. Nur Admin. 404 wenn nicht gefunden."
          }
        },
        {
          "name": "Trainingsfokus erstellen (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "{{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"beschreibung\": \"Verbesserung der Schrittarbeit\",\n  \"schwerpunkt\": \"Schrittarbeit\",\n  \"kategorie\": \"Kumite\",\n  \"notiz\": \"Fokus auf Tai Sabaki\",\n  \"status\": \"AKTIV\",\n  \"sportlerId\": \"sp-123\",\n  \"dauerWochen\": 4,\n  \"einheitenProWoche\": 3,\n  \"minutenProEinheit\": 60,\n  \"turniername\": \"Kantonalmeisterschaft\",\n  \"turnierdatum\": \"2026-06-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/trainingsfokus",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trainingsfokus"]
            },
            "description": "Erstellt einen neuen Trainingsfokus für einen Sportler. Nur Admin. 400 wenn Sportler nicht existiert."
          }
        },
        {
          "name": "Status eines Trainingsfokus ändern (Admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/trainingsfokus/:id/status?status=INAKTIV",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trainingsfokus", ":id", "status"],
              "variable": [{ "key": "id", "value": "tf-123", "description": "MongoDB ID des Trainingsfokus" }],
              "query": [{ "key": "status", "value": "INAKTIV", "description": "AKTIV oder INAKTIV" }]
            },
            "description": "Ändert den Status eines Trainingsfokus auf AKTIV oder INAKTIV. Nur Admin. 400 bei ungültigem Status, 404 wenn nicht gefunden."
          }
        },
        {
          "name": "Trainingsfokus als gelesen markieren",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/trainingsfokus/:id/gelesen",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trainingsfokus", ":id", "gelesen"],
              "variable": [{ "key": "id", "value": "tf-123", "description": "MongoDB ID des Trainingsfokus" }]
            },
            "description": "Markiert einen Trainingsfokus als gelesen. Nur der zugehörige Sportler darf dies tun. 403 wenn fremder Sportler, 404 wenn nicht gefunden."
          }
        },
        {
          "name": "Trainingsfokus löschen (Admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/trainingsfokus/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trainingsfokus", ":id"],
              "variable": [{ "key": "id", "value": "tf-123", "description": "MongoDB ID des Trainingsfokus" }]
            },
            "description": "Löscht einen Trainingsfokus. Nur Admin. 404 wenn nicht gefunden."
          }
        }
      ]
    },
    {
      "name": "Trainingsplan",
      "item": [
        {
          "name": "Alle Trainingspläne abrufen (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/trainingsplan?page=0&size=10&status=&sportlerName=&minDauer=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trainingsplan"],
              "query": [
                { "key": "page", "value": "0", "description": "Seitennummer" },
                { "key": "size", "value": "10", "description": "Einträge pro Seite" },
                { "key": "status", "value": "", "description": "ACTIVE, COMPLETED oder ARCHIVED (optional)" },
                { "key": "sportlerName", "value": "", "description": "Filter nach Sportlername (optional)" },
                { "key": "minDauer", "value": "", "description": "Minimale Dauer in Minuten (optional)" }
              ]
            },
            "description": "Gibt alle Trainingspläne zurück. Nur Admin. Filterbar nach Status, Sportlername und Mindestdauer."
          }
        },
        {
          "name": "Eigene Trainingspläne abrufen",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/trainingsplan/me?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trainingsplan", "me"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            },
            "description": "Gibt die Trainingspläne des eingeloggten Sportlers zurück."
          }
        },
        {
          "name": "Trainingsplan nach ID abrufen (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/trainingsplan/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trainingsplan", ":id"],
              "variable": [{ "key": "id", "value": "tp-123", "description": "MongoDB ID des Trainingsplans" }]
            },
            "description": "Gibt einen einzelnen Trainingsplan anhand der ID zurück. Nur Admin."
          }
        },
        {
          "name": "Trainingsplan erstellen (Admin, AI-generierter Titel)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "{{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titel\": \"Kumite Vorbereitung\",\n  \"fokus\": \"Schrittarbeit und Konter\",\n  \"dauer\": 60,\n  \"status\": \"ACTIVE\",\n  \"sportlerId\": \"sp-123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/trainingsplan",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trainingsplan"]
            },
            "description": "Erstellt einen neuen Trainingsplan. Der Titel wird durch Claude AI verbessert. Nur Admin. 400 wenn Sportler nicht existiert."
          }
        },
        {
          "name": "Trainingsplan aus Trainingsfokus generieren (AI)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/trainingsplan/aus-fokus/:fokusId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trainingsplan", "aus-fokus", ":fokusId"],
              "variable": [{ "key": "fokusId", "value": "tf-123", "description": "MongoDB ID des Trainingsfokus" }]
            },
            "description": "Generiert automatisch einen detaillierten Trainingsplan anhand eines Trainingsfokus mittels Claude AI. Nur der zugehörige Sportler kann seinen eigenen Fokus verwenden. 403 bei fremdem Fokus, 404 wenn nicht gefunden."
          }
        },
        {
          "name": "Zufälligen Trainingsplan erstellen (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "{{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sportlerId\": \"sp-123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/trainingsplan/random",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trainingsplan", "random"]
            },
            "description": "Erstellt einen zufälligen AI-generierten Trainingsplan für einen Sportler. Nur Admin."
          }
        },
        {
          "name": "Trainingsplan löschen (Admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/trainingsplan/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trainingsplan", ":id"],
              "variable": [{ "key": "id", "value": "tp-123", "description": "MongoDB ID des Trainingsplans" }]
            },
            "description": "Löscht einen Trainingsplan. Nur Admin. 404 wenn nicht gefunden."
          }
        }
      ]
    },
    {
      "name": "Trainingsplan Service",
      "item": [
        {
          "name": "Trainingsplan aktivieren (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "{{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trainingsplanId\": \"tp-123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/service/activateTrainingsplan",
              "host": ["{{baseUrl}}"],
              "path": ["api", "service", "activateTrainingsplan"]
            },
            "description": "Ändert den Status eines Trainingsplans von DRAFT auf ACTIVE. Sendet automatisch eine E-Mail an den Sportler. Nur Admin. 400 wenn Plan nicht gefunden oder falscher Status."
          }
        },
        {
          "name": "Trainingsplan abschliessen (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "{{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trainingsplanId\": \"tp-123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/service/completeTrainingsplan",
              "host": ["{{baseUrl}}"],
              "path": ["api", "service", "completeTrainingsplan"]
            },
            "description": "Ändert den Status eines Trainingsplans von ACTIVE auf COMPLETED. Sendet automatisch eine Glückwunsch-E-Mail an den Sportler. Nur Admin. 400 wenn Plan nicht gefunden oder falscher Status."
          }
        },
        {
          "name": "Trainingsplan archivieren (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "{{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trainingsplanId\": \"tp-123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/service/archiveTrainingsplan",
              "host": ["{{baseUrl}}"],
              "path": ["api", "service", "archiveTrainingsplan"]
            },
            "description": "Ändert den Status eines Trainingsplans von COMPLETED auf ARCHIVED. Nur Admin. 400 wenn Plan nicht gefunden oder falscher Status."
          }
        },
        {
          "name": "Trainingsplan Dashboard (Status-Übersicht)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/service/trainingsplanDashboard?sportlerId=sp-123",
              "host": ["{{baseUrl}}"],
              "path": ["api", "service", "trainingsplanDashboard"],
              "query": [{ "key": "sportlerId", "value": "sp-123", "description": "MongoDB ID des Sportlers" }]
            },
            "description": "Gibt eine Statusübersicht (Aggregation) der Trainingspläne eines Sportlers zurück. 400 wenn Sportler nicht existiert."
          }
        }
      ]
    },
    {
      "name": "Chat (AI)",
      "item": [
        {
          "name": "Chat-Nachricht senden",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "{{token}}" },
              { "key": "Content-Type", "value": "text/plain" }
            ],
            "body": {
              "mode": "raw",
              "raw": "Erstelle mir einen Trainingsplan. Schwerpunkt: Kata. Dauer: 4 Wochen."
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat"]
            },
            "description": "Sendet eine Nachricht an den Claude AI Karate-Coach. Falls die Nachricht 'Trainingsplan' und 'Schwerpunkt:' enthält, wird der generierte Plan automatisch gespeichert. Antwort ist plain text."
          }
        }
      ]
    }
  ]
}
